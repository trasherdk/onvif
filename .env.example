# Camera connection (examples 1–3, 5–9, example2, capture-onvif-baseline.js)
CAMERA_HOST=192.168.1.34
USERNAME=admin
PASSWORD=password
PORT=5000

# Brute-force ONVIF scan (example7.js) — fallback when example4 discovery finds nothing
# Defaults to local /24; override range if needed:
# SCAN_RANGE_START=192.168.1.1
# SCAN_RANGE_END=192.168.1.254
# SCAN_INTERFACE=eth0
# SCAN_PORTS=5000,80
# SCAN_TIMEOUT=2500
# SCAN_INCLUDE_GATEWAY=1

# SOCKS proxy (example5.js only)

# WS-Discovery (example4.js) — no CAMERA_HOST needed for discovery
DISCOVERY_TIMEOUT=8000
DISCOVERY_INTERFACE=eth0
DISCOVERY_SUBNET_SCAN=1
DISCOVERY_CONNECT=0

# ONVIF events, SUBSCRIBE mode (example6.js)
# IP of the machine running example6 (camera POSTs events here); auto-detected if unset
EVENT_RECEIVER_IP=192.168.1.81
EVENT_RECEIVER_PORT=8086
